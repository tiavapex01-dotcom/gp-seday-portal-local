# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# DATABASE_URL → Pooling (porta 6543) — runtime do Prisma
# DIRECT_URL   → Direto  (porta 5432) — prisma db push / migrate
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # service_role key (nunca expor no front-end)

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
# Em desenvolvimento: http://localhost:3000
# Em produção (Vercel): https://seu-projeto.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Sentry (monitoramento de erros) ──────────────────────────────────────────
# DSN público — visível no browser, sem risco expor
# Encontre em: sentry.io → Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN="https://[public-key]@o[org-id].ingest.sentry.io/[project-id]"
# Token para upload de source maps no CI/CD
# Gere em: sentry.io → Settings → Auth Tokens → Create New Token (escopo: project:releases)
SENTRY_AUTH_TOKEN="sntrys_..."
# Slug da organização no Sentry (aparece na URL: sentry.io/organizations/[slug]/)
SENTRY_ORG="[org-slug]"
# Slug do projeto no Sentry
SENTRY_PROJECT="[project-slug]"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  cpf       String?  @unique // 11 dígitos sem formatação — null para usuários legados
  phone     String?  @unique // 10 ou 11 dígitos sem formatação — null para usuários legados
  password  String
  role      String   @default("employee") // "admin" | "manager" | "employee"
  company   String   // "AVAPEX" | "SEDAY" | "INNOMACH"
  sector    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedFiles    File[]           @relation("UploadedBy")
  communications   Communication[]  @relation("CreatedBy")
  createdFolders   Folder[]         @relation("FolderCreatedBy")
  uploadedContents Content[]        @relation("ContentUploadedBy")

  @@index([company])
  @@index([role])
  @@index([active])
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  isRoot      Boolean  @default(false) // pastas raiz (setores) — não podem ser excluídas
  company     String   // "AVAPEX" | "SEDAY" | "INNOMACH" | "ALL"
  createdAt   DateTime @default(now())

  // Hierarquia: null = pasta raiz de setor
  parentId    String?
  parent      Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("SubFolders")

  // Quem criou (null nas pastas raiz geradas pelo seed)
  createdById String?
  createdBy   User?    @relation("FolderCreatedBy", fields: [createdById], references: [id])

  files       File[]

  @@index([parentId])
  @@index([company])
  @@index([isRoot])
}

model File {
  id          String   @id @default(cuid())
  name        String
  storedName  String
  path        String
  mimeType    String
  size        Int
  description String?
  company     String
  sector      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId     String
  folder       Folder @relation(fields: [folderId], references: [id])

  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  @@index([folderId])
  @@index([company])
}

model Communication {
  id           String   @id @default(cuid())
  title        String
  content      String
  company      String
  sector       String?
  contactPhone String?
  contactEmail String?
  pinned       Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String

  @@index([published])
  @@index([company])
  @@index([pinned])
  @@index([sector])
  @@index([published, createdAt])
}

// ── Central de Conteúdo ───────────────────────────────────────────────────────

model ContentCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  icon        String?  // emoji
  order       Int      @default(0)
  company     String   // "AVAPEX" | "SEDAY" | "INNOMACH" | "ALL"
  createdAt   DateTime @default(now())

  contents    Content[]

  @@index([company])
  @@index([slug])
}

model Content {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String   // "image"|"video"|"document"|"template"|"signature"|"social"
  company       String   // "AVAPEX" | "SEDAY" | "INNOMACH"
  tags          String[] // ex: ["logo","horizontal","fundo-branco"]
  storedName    String   // UUID filename in Supabase
  path          String   // full path in bucket
  mimeType      String
  size          Int      // bytes
  thumbnailPath String?  // preview for images/videos (optional)
  published     Boolean  @default(true)
  featured      Boolean  @default(false)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId   String
  category     ContentCategory @relation(fields: [categoryId], references: [id])

  uploadedById String
  uploadedBy   User    @relation("ContentUploadedBy", fields: [uploadedById], references: [id])

  @@index([company])
  @@index([type])
  @@index([categoryId])
  @@index([featured])
  @@index([published])
}
